# Frontend (Vite) — prefixo VITE_ exposto ao browser
VITE_USE_API=true
VITE_SSO_ENABLED=false

# API / Vercel (não commitar valores reais)
AUTH_SECRET=

# Senhas de produção — gere com: npx tsx scripts/hash-password.ts "<senha>"
# Com AUTH_SECRET ativo e sem hash configurado, o login por senha do usuário
# fica desabilitado (resta o SSO).
AUTH_PASSWORD_SALT=
AUTH_PASSWORD_HASH_GESTAO=
AUTH_PASSWORD_HASH_COMERCIAL=
AUTH_PASSWORD_HASH_JURIDICO=

DATABASE_URL=
AGRO_SETUP_SECRET=
APP_URL=https://jgg-agro-hub.vercel.app

# Rate-limit distribuído (opcional; se ausente, fallback in-memory por function)
# Upstash Redis (recomendado); KV_REST_* também é aceito para compatibilidade.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# SSO OIDC (opcional)
SSO_ENABLED=false
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://jgg-agro-hub.vercel.app/api/auth/callback

# ── Copilot LLM (opcional — sem chave, usa keyword engine mock) ──────
# Provider: openai | anthropic | google | ollama | groq | openrouter
COPILOT_PROVIDER=
# Modelo específico do provider (ex: gpt-5.4, claude-sonnet-4-6, gemini-3.1-pro)
COPILOT_MODEL=
# Provider de embeddings (pode ser diferente do LLM; suporta: openai, google, ollama, openrouter)
COPILOT_EMBEDDINGS_PROVIDER=
COPILOT_EMBEDDINGS_MODEL=

# ── API Keys (configure apenas o provider que irá usar) ─────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
GROQ_API_KEY=
OPENROUTER_API_KEY=