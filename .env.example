# Frontend (Vite) — prefixo VITE_ exposto ao browser
VITE_USE_API=true
VITE_SSO_ENABLED=false

# API / Vercel (não commitar valores reais)
AUTH_SECRET=

# Senhas de produção — gere com: npx tsx scripts/hash-password.ts "<senha>"
# Com AUTH_SECRET ativo e sem hash configurado, o login por senha do usuário
# fica desabilitado (resta o SSO).
AUTH_PASSWORD_SALT=
AUTH_PASSWORD_HASH_GESTAO=
AUTH_PASSWORD_HASH_COMERCIAL=
AUTH_PASSWORD_HASH_JURIDICO=

DATABASE_URL=
AGRO_SETUP_SECRET=
APP_URL=https://jgg-agro-hub.vercel.app

# SSO OIDC (opcional)
SSO_ENABLED=false
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://jgg-agro-hub.vercel.app/api/auth/callback