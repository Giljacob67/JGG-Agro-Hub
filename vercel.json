{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/command-center",
      "destination": "/agro/command-center",
      "permanent": true
    },
    {
      "source": "/crm",
      "destination": "/agro/crm",
      "permanent": true
    },
    {
      "source": "/crm/leads",
      "destination": "/agro/crm/leads",
      "permanent": true
    },
    {
      "source": "/crm/accounts",
      "destination": "/agro/crm/accounts",
      "permanent": true
    },
    {
      "source": "/crm/opportunities",
      "destination": "/agro/crm/opportunities",
      "permanent": true
    },
    {
      "source": "/crm/matters",
      "destination": "/agro/crm/matters",
      "permanent": true
    },
    {
      "source": "/crm/tasks",
      "destination": "/agro/crm/tasks",
      "permanent": true
    }
  ],
  "functions": {
    "api/admin/db-setup.ts": { "includeFiles": "{shared/**,api/_lib/**}" },
    "api/agro/[resource].ts": { "includeFiles": "{shared/**,api/_lib/**}" },
    "api/auth/[action].ts": { "includeFiles": "{shared/**,api/_lib/**}" },
    "api/health/db.ts": { "includeFiles": "{shared/**,api/_lib/**}" },
    "api/upload.ts": { "includeFiles": "{shared/**,api/_lib/**}" }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://*.r2.cloudflarestorage.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" }
      ]
    }
  ]
}